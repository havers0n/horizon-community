{
  "name": "roleplay-identity",
  "version": "1.0.0",
  "description": "RolePlay Identity System",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:mdt\" \"npm run dev:server\"",
    "dev:client": "cd apps/client && npm run dev",
    "dev:mdt": "cd apps/mdtclient && npm run dev",
    "dev:server": "cd apps/server && npm run dev",
    "dev:all": "concurrently -n \"client,mdt,server\" -c \"blue,green,yellow\" \"npm run dev:client\" \"npm run dev:mdt\" \"npm run dev:server\"",
    "build": "npm run build:client && npm run build:mdt && npm run build:server",
    "build:production": "npm run build:client && npm run build:mdt && npm run build:server",
    "build:client": "cd apps/client && npm run build",
    "build:mdt": "cd apps/mdtclient && npm run build",
    "build:server": "cd apps/server && npm run build",
    "build:archive": "node scripts/build-and-archive.js",
    "build:archive:ps": "powershell -ExecutionPolicy Bypass -File scripts/build-and-archive.ps1",
    "build:archive:simple": "node scripts/build-and-archive-simple.js",
    "build:archive:correct": "node scripts/build-and-archive-correct.js",
    "install:all": "npm install",
    "install:all:production": "npm ci --production",
    "clean": "npm run clean:client && npm run clean:mdt && npm run clean:server",
    "clean:client": "cd apps/client && npm run clean",
    "clean:mdt": "cd apps/mdtclient && npm run clean",
    "clean:server": "cd apps/server && npm run clean",
    "lint": "npm run lint:client && npm run lint:mdt && npm run lint:server",
    "lint:client": "cd apps/client && npm run lint",
    "lint:mdt": "cd apps/mdtclient && npm run lint",
    "lint:server": "cd apps/server && npm run lint",
    "test": "npm run test:client && npm run test:mdt && npm run test:server",
    "test:client": "cd apps/client && npm run test",
    "test:mdt": "cd apps/mdtclient && npm run test",
    "test:server": "cd apps/server && npm run test",
    "check-ports": "node scripts/check-ports.js",
    "check-production": "node scripts/check-production-config.js",
    "check-modules": "node scripts/fix-module-issues.js",
    "force-rebuild": "node scripts/force-rebuild.js"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "libs/*/*"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
