    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Полная коллекция эндпоинтов серверного API (/api, /api/v1). Для защищённых запросов используйте переменную {{authToken}} в заголовке Authorization."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:5000" },
    { "key": "version", "value": "v1" },
    { "key": "authToken", "value": "" },
    { "key": "origin", "value": "http://localhost:3001" },
    { "key": "register_username", "value": "testuser2" },
    { "key": "register_email", "value": "test11@example.com" },
    { "key": "register_password", "value": "StrongP@ssw0rd" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "try {",
          "  var origin = pm.variables.get('origin') || 'http://localhost:3001';",
          "  if (!pm.request.headers.has('Origin')) {",
          "    pm.request.headers.add({ key: 'Origin', value: origin });",
          "  } else {",
          "    pm.request.headers.upsert({ key: 'Origin', value: origin });",
          "  }",
          "} catch (e) { }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
        },
        {
          "name": "GET /api/{{version}}/health",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/{{version}}/health" }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/{{version}}/auth/register",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{register_username}}\",\n  \"email\": \"{{register_email}}\",\n  \"password\": \"{{register_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/{{version}}/auth/register",
            "description": "Регистрация пользователя."
          }
        },
        {
          "name": "POST /api/{{version}}/auth/login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{register_email}}\",\n  \"password\": \"{{register_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/{{version}}/auth/login",
            "description": "Вход пользователя. Возвращает access_token и refresh_token."
          }
        },
        {
          "name": "POST /api/{{version}}/auth/verify",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<JWT or other>\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/{{version}}/auth/verify",
            "description": "Проверка токена (заготовка)."
          }
        },
        {
          "name": "GET /api/{{version}}/auth/me",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{authToken}}" } ],
            "url": "{{baseUrl}}/api/{{version}}/auth/me",
            "description": "Профиль текущего пользователя."
          }
        },
        {
          "name": "POST /api/{{version}}/auth/logout",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{authToken}}" } ],
            "url": "{{baseUrl}}/api/{{version}}/auth/logout",
            "description": "Выход из системы (клиент удаляет токен)."
          }
        }
      ]
    },
