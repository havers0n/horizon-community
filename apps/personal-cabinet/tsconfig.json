//apps/personal-cabinet/tsconfig.json

{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping for FSD architecture */
    "baseUrl": ".",
    "paths": {
      // --- Ваши существующие пути ---
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@pages/*": ["./src/pages/*"],
      "@widgets/*": ["./src/widgets/*"],
      "@features/*": ["./src/features/*"],
      "@entities/*": ["./src/entities/*"],
      "@shared/*": ["./src/shared/*"],
      "@shared": ["./src/shared"],
      "@shared/ui": ["./src/shared/ui"],
      "@ui": ["../../libs/ui-components/src"],
      "@shared/ui-components": ["../../libs/ui-components/src"],
      
      // === ДОБАВЛЕННЫЙ ПУТЬ К ТИПАМ ===
      "@roleplay-identity/db-types": ["../../packages/db-types/src/index.ts"],
      "@roleplay-identity/shared-types": ["../../libs/shared-types/src/index.ts"],
      "@roleplay-identity/shared-types/*": ["../../libs/shared-types/src/*"]
    }
  },
  "include": [
    "src", 
    "../../libs/ui-components/src",
    // Я также добавил путь к db-types в include для лучшей интеграции с IDE
    "../../packages/db-types/src",
    "../../libs/shared-types/src"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}