	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Логирование запросов",
					"console.log('Отправка запроса:', pm.request.method, pm.request.url);",
					"",
					"// Добавление временной метки",
					"pm.request.headers.add({",
					"    key: 'X-Request-Timestamp',",
					"    value: new Date().toISOString()",
					"});"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Автоматические тесты для каждого запроса",
					"pm.test('Статус код успешный', function () {",
					"    pm.response.to.have.status(200);",
					"});",
					"",
					"pm.test('Время ответа меньше 5 секунд', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(5000);",
					"});",
					"",
					"pm.test('Content-Type установлен', function () {",
					"    pm.response.to.have.header('Content-Type');",
					"});",
					"",
					"// Проверка структуры JSON ответа",
					"if (pm.response.headers.get('Content-Type').includes('application/json')) {",
					"    pm.test('Ответ является валидным JSON', function () {",
					"        pm.response.to.be.json;",
					"    });",
					"}",
					"",
					"// Сохранение переменных из ответа",
					"if (pm.response.json().id) {",
					"    pm.collectionVariables.set('last_created_id', pm.response.json().id);",
					"}",
					"",
					"if (pm.response.json().testId) {",
					"    pm.collectionVariables.set('test_id', pm.response.json().testId);",
					"}",
					"",
					"if (pm.response.json().resultId) {",
					"    pm.collectionVariables.set('result_id', pm.response.json().resultId);",
					"}"
				]
			}
		}
